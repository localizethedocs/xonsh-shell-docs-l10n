msgstr ""

#: ../../../../xonsh/xontribs.py:docstring of
#: xonsh.xontribs.ExitCode.as_integer_ratio:2
msgid "Return a pair of integers, whose ratio is equal to the original int."
msgstr ""

#: ../../../../xonsh/xontribs.py:docstring of
#: xonsh.xontribs.ExitCode.as_integer_ratio:4
msgid "The ratio is in lowest terms and has a positive denominator."
msgstr ""

#: ../../../../xonsh/xontribs.py:docstring of
#: xonsh.xontribs.ExitCode.bit_count:2
msgid ""
"Number of ones in the binary representation of the absolute value of self."
msgstr ""

