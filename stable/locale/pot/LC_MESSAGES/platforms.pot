#: ../../../platforms.rst:131
msgid ""
"You can add `man page color support`_ using ``less`` environment variables — "
"these work on any POSIX system with ``less`` as the pager:"
msgstr ""

#: ../../../platforms.rst:134
msgid ""
"# format is '\\E[<brightness>;<colour>m'\n"
"$LESS_TERMCAP_mb = \"\\033[01;31m\"     # begin blinking\n"
"$LESS_TERMCAP_md = \"\\033[01;31m\"     # begin bold\n"
"$LESS_TERMCAP_me = \"\\033[0m\"         # end mode\n"
"$LESS_TERMCAP_so = \"\\033[01;44;36m\"  # begin standout-mode\n"
"$LESS_TERMCAP_se = \"\\033[0m\"         # end standout-mode\n"
"$LESS_TERMCAP_us = \"\\033[00;36m\"     # begin underline\n"
"$LESS_TERMCAP_ue = \"\\033[0m\"         # end underline"
msgstr ""

#: ../../../platforms.rst:151
msgid "``libgcc_s.so.1`` error on startup"
msgstr ""

#: ../../../platforms.rst:153
msgid ""
"On certain (mostly older or stripped) Linux distributions you may "
"occasionally see this error when starting xonsh:"
