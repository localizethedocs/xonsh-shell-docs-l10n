#: ../../../../xonsh/procs/executables.py:docstring of
#: xonsh.procs.executables.get_possible_names:4
msgid ""
"PATHEXT is a Windows convention containing extensions to be considered when "
"searching for an executable file."
msgstr ""

#: ../../../../xonsh/procs/executables.py:docstring of
#: xonsh.procs.executables.get_possible_names:7
msgid ""
"Conserves order of any extensions found and gives precedence to the bare "
"name."
msgstr ""

