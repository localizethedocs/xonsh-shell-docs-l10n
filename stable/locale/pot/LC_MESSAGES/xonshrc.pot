#: ../../../xonshrc.rst:95
msgid "Real world sample rc.py"
msgstr ""

#: ../../../xonshrc.rst:97
msgid ""
"The following is a real-world example of such a file. This can be set by "
"``env XONSHRC=rc.py xonsh`` or ``xonsh --rc=rc.py``"
msgstr ""

#: ../../../xonshrc.rst:100
msgid ":download:`Download rc.py <xonshrc.py>`"
msgstr ""

#: ../../../xonshrc.rst:102
msgid ""
"from xonsh.built_ins import XSH\n"
"\n"
"env = XSH.env\n"
"# adjust some paths\n"
"env[\"PATH\"].append(\"/home/snail/sandbox/bin\")\n"
"env[\"LD_LIBRARY_PATH\"] = [\"/home/snail/.local/lib\", \"/home/snail/"
"miniconda3/lib\"]\n"
"\n"
"# alias to quit AwesomeWM from the terminal\n"
"@XSH.aliases.register(\"qa\")\n"
"def _quit_awesome(args, stdin=None):\n"
"    print(\"awesome python code\")\n"
"\n"
"# setting aliases as list are faster since they don't involve parser.\n"
"XSH.aliases[\"gc\"] = [\"git\", \"commit\"]\n"
"\n"
"# some customization options, see https://xon.sh/envvars.html for details\n"
"env[\"MULTILINE_PROMPT\"] = \"`·.,¸,.·*¯`·.,¸,.·*¯\"\n"
"env[\"XONSH_SHOW_TRACEBACK\"] = True\n"
"env[\"XONSH_STORE_STDOUT\"] = True\n"
"env[\"XONSH_HISTORY_MATCH_ANYWHERE\"] = True\n"
"env[\"COMPLETIONS_CONFIRM\"] = True\n"
"env[\"XONSH_AUTOPAIR\"] = True\n"
msgstr ""

#: ../../../xonshrc.rst:107
msgid "Snippets for xonshrc"
msgstr ""

#: ../../../xonshrc.rst:109
msgid ""
"The following are useful snippets and code that tweaks and adjust xonsh in "
"various ways. If you have any useful tricks, feel free to share them."
msgstr ""

#: ../../../xonshrc.rst:113
msgid "Adjust how git branch label behaves"
msgstr ""

#: ../../../xonshrc.rst:114
msgid ""
"Xonsh adds a colored branch name to the prompt when working with git or hg "
"repositories. This behavior can be controlled with the ``$PROMPT`` "
"environment variable. See how to `customize the prompt`_ . The branch name "
"changes color if the work dir is dirty or not. This is controlled by the "
"``{branch_color}`` formatter string."
msgstr ""

#: ../../../xonshrc.rst:119
msgid ""
"The following snippet reimplements the formatter also to include untracked "
"files when considering if a git directory is dirty."
msgstr ""

#: ../../../xonshrc.rst:121
msgid ""
"from xonsh.prompt.vc import git_dirty_working_directory\n"
"$VC_GIT_INCLUDE_UNTRACKED = True\n"
"$PROMPT_FIELDS['branch_color'] = lambda: ('{BOLD_INTENSE_RED}'\n"
"                                               if "
"git_dirty_working_directory()\n"
"                                               else '{BOLD_INTENSE_GREEN}')"
msgstr ""

#: ../../../xonshrc.rst:134
msgid "Get better colors from the ``ls`` command"
msgstr ""

#: ../../../xonshrc.rst:135
msgid ""
"The colors of the ``ls`` command may be hard to read in a dark terminal. If "
"so, this is an excellent addition to the xonshrc file."
msgstr ""

#: ../../../xonshrc.rst:137
msgid ""
"$LS_COLORS='rs=0:di=01;36:ln=01;36:mh=00:pi=40;33:so=01;35:do=01;35:"
"bd=40;33;01:cd=40;33;01:or=40;31;01:su=37;41:sg=30;43:ca=30;41:tw=30;42:"
"ow=34;42:st=37;44:ex=01;32:'"
msgstr ""

#: ../../../xonshrc.rst:142
msgid "Make JSON data directly pastable"
msgstr ""

#: ../../../xonshrc.rst:143
msgid ""
"With the following snippet, xonsh will understand JSON data such as "
"``{ \"name\": \"Tyler\", \"active\": false, \"age\": null }``. Note that "
"this injects names into Python's ``builtins`` module, which is rather hacky "
"and might break other functionality. Use at your own risk."
msgstr ""

#: ../../../xonshrc.rst:147
msgid ""
"import builtins\n"
"builtins.true = True\n"
"builtins.false = False\n"
"builtins.null = None"
msgstr ""

#: ../../../xonshrc.rst:155
msgid "Display different date information every 10th time"
msgstr ""

#: ../../../xonshrc.rst:156
msgid ""
"For a compact shell prompts, some people prefer a very condensed time "
"format. But when you have a lengthy shell session you might want the date to "
"show up in your logs every now and then..."
msgstr ""

#: ../../../xonshrc.rst:158
msgid ""
"import time\n"
"def get_shelldate():\n"
"    get_shelldate.fulldate %= 10\n"
"    get_shelldate.fulldate += 1\n"
"    if get_shelldate.fulldate == 1:\n"
"        return time.strftime('%d%m%Y')\n"
"    return time.strftime('%H:%M')\n"
"get_shelldate.fulldate = 0\n"
"\n"
"$PROMPT_FIELDS['shelldate'] = get_shelldate"
msgstr ""

