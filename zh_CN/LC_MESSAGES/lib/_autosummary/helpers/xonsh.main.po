#: ../../../../xonsh/main.py:docstring of xonsh.main.setup:2
msgid ""
"Starts up a new xonsh shell. Calling this in function in another packages "
"``__init__.py`` will allow xonsh to be fully used in the package in headless "
"or headed mode. This function is primarily indended to make starting up "
"xonsh for 3rd party packages easier."
msgstr ""

#: ../../../../xonsh/main.py:docstring of xonsh.main.setup:7
msgid "Here is example of using this at the top of an ``__init__.py``::"
msgstr ""

#: ../../../../xonsh/main.py:docstring of xonsh.main.setup:9
msgid ""
"from xonsh.main import setup\n"
"setup()\n"
"del setup"
msgstr ""

