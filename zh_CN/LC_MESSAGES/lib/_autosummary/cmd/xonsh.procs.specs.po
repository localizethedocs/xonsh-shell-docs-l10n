#: xonsh.procs.specs.parse_shebang_from_file:2
msgid ""
"Returns shebang for a file or None. Doc: https://www.gnu.org/software/guile/"
"manual/html_node/The-Meta-Switch.html"
msgstr ""

#: ../../../../xonsh/procs/specs.py:docstring of
#: xonsh.procs.specs.run_subproc:2
msgid ""
"Runs a subprocess, in its many forms. This takes a list of 'commands,' which "
"may be a list of command line arguments or a string, representing a special "
"connecting character.  For example::"
msgstr ""

#: ../../../../xonsh/procs/specs.py:docstring of
#: xonsh.procs.specs.run_subproc:6
msgid "$ ls | grep wakka"
msgstr ""

#: ../../../../xonsh/procs/specs.py:docstring of
#: xonsh.procs.specs.run_subproc:8
msgid "is represented by the following cmds::"
msgstr ""

#: ../../../../xonsh/procs/specs.py:docstring of
#: xonsh.procs.specs.run_subproc:10
msgid "[['ls'], '|', ['grep', 'wakka']]"
msgstr ""

#: ../../../../xonsh/procs/specs.py:docstring of
#: xonsh.procs.specs.run_subproc:12
msgid "Lastly, the captured argument affects only the last real command."
msgstr ""

#: ../../../../xonsh/procs/specs.py:docstring of
#: xonsh.procs.specs.run_subproc:14
msgid ""
"``in_boolop`` is forwarded from the parser; True when this whole pipeline is "
"a direct operand of a ``&&``/``||`` chain.  Each spec receives ``spec."
"in_boolop`` so downstream consumers can act on it (e.g. let a non-zero "
"return short-circuit instead of raising)."
msgstr ""

