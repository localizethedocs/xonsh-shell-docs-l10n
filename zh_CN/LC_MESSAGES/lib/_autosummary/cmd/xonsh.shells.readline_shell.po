#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineHistoryAdder:2
msgid ""
"Thread responsible for adding inputs from history to the current readline "
"instance. May wait for the history garbage collector to finish."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.getName:2
msgid "Return a string used for identification purposes only."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.getName:4 threading.Thread.setName:4
msgid "This method is deprecated, use the name attribute instead."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.isDaemon:2
msgid "Return whether this thread is a daemon."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.isDaemon:4
msgid "This method is deprecated, use the daemon attribute instead."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.is_alive:2
msgid "Return whether the thread is alive."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.is_alive:4
msgid ""
"This method returns True just before the run() method starts until just "
"after the run() method terminates. See also the module function enumerate()."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.join:2
msgid "Wait until the thread terminates."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.join:4
msgid ""
"This blocks the calling thread until the thread whose join() method is "
"called terminates -- either normally or through an unhandled exception or "
"until the optional timeout occurs."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.join:8
msgid ""
"When the timeout argument is present and not None, it should be a floating-"
"point number specifying a timeout for the operation in seconds (or fractions "
"thereof). As join() always returns None, you must call is_alive() after "
"join() to decide whether a timeout happened -- if the thread is still alive, "
"the join() call timed out."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.join:14
msgid ""
"When the timeout argument is not present or None, the operation will block "
"until the thread terminates."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.join:17
msgid "A thread can be join()ed many times."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.join:19
msgid ""
"join() raises a RuntimeError if an attempt is made to join the current "
"thread as that would cause a deadlock. It is also an error to join() a "
"thread before it has been started and attempts to do so raises the same "
"exception."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineHistoryAdder.run:2
msgid "Method representing the thread's activity."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineHistoryAdder.run:4
msgid ""
"You may override this method in a subclass. The standard run() method "
"invokes the callable object passed to the object's constructor as the target "
"argument, if any, with sequential and keyword arguments taken from the args "
"and kwargs arguments, respectively."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.setDaemon:2
msgid "Set whether this thread is a daemon."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.setDaemon:4
msgid "This method is deprecated, use the .daemon property instead."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.setName:2
msgid "Set the name string for this thread."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.start:2
msgid "Start the thread's activity."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.start:4
msgid ""
"It must be called at most once per thread object. It arranges for the "
"object's run() method to be invoked in a separate thread of control."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: threading.Thread.start:7
msgid ""
"This method will raise a RuntimeError if called more than once on the same "
"thread object."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineHistoryAdder.daemon:2
msgid "A boolean value indicating whether this thread is a daemon thread."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineHistoryAdder.daemon:4
msgid ""
"This must be set before start() is called, otherwise RuntimeError is raised. "
"Its initial value is inherited from the creating thread; the main thread is "
"not a daemon thread and therefore all threads created in the main thread "
"default to daemon = False."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineHistoryAdder.daemon:9
msgid "The entire Python program exits when only daemon threads are left."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineHistoryAdder.ident:2
msgid "Thread identifier of this thread or None if it has not been started."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineHistoryAdder.ident:4
msgid ""
"This is a nonzero integer. See the get_ident() function. Thread identifiers "
"may be recycled when a thread exits and another thread is created. The "
"identifier is available even after the thread has exited."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineHistoryAdder.name:2
msgid "A string used for identification purposes only."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineHistoryAdder.name:4
msgid ""
"It has no semantics. Multiple threads may be given the same name. The "
"initial name is set by the constructor."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineHistoryAdder.native_id:2
msgid ""
"Native integral thread ID of this thread, or None if it has not been started."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineHistoryAdder.native_id:4
msgid ""
"This is a non-negative integer. See the get_native_id() function. This "
"represents the Thread ID as reported by the kernel."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineShell:38
msgid "Notes"
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineShell:39
msgid ""
"classes inheriting multiple base classes should call them explicitly as done "
"for ``ReadlineShell``"
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineShell.cmdloop:2
msgid ""
"Repeatedly issue a prompt, accept input, parse an initial prefix off the "
"received input, and dispatch to action methods, passing them the remainder "
"of the line as argument."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineShell.color_style:2
msgid "Returns the current color map."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineShell.color_style_names:2
msgid "Returns an iterable of all available style names."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of cmd.Cmd.columnize:2
msgid "Display a list of strings as a compact set of columns."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of cmd.Cmd.columnize:4
msgid ""
"Each column is only as wide as necessary. Columns are separated by two "
"spaces (one was not legible enough)."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.base_shell.BaseShell.compile:2
msgid ""
"Compiles source code and returns the (possibly modified) source and a valid "
"code object."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of cmd.Cmd.complete:2
msgid "Return the next possible completion for 'text'."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of cmd.Cmd.complete:4
msgid ""
"If a command has not been entered, then complete against command list. "
"Otherwise try to call complete_<command> to get list of completions."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineShell.completedefault:2
msgid "Implements tab-completion for text."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.base_shell.BaseShell.default:2
msgid "Implements code execution."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of cmd.Cmd.do_help:2
msgid ""
"List available commands with \"help\" or detailed help with \"help cmd\"."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.base_shell.BaseShell.emptyline:2
msgid "Called when an empty line has been entered."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineShell.format_color:2
msgid ""
"Readline implementation of color formatting. This uses ANSI color codes."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of cmd.Cmd.onecmd:2
msgid ""
"Interpret the argument as though it had been typed in response to the prompt."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of cmd.Cmd.onecmd:5
msgid ""
"This may be overridden, but should not normally need to be; see the precmd() "
"and postcmd() methods for useful execution hooks. The return value is a flag "
"indicating whether interpretation of commands by the interpreter should stop."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineShell.parseline:2
msgid "Overridden to no-op."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineShell.postcmd:2
msgid ""
"Called just before execution of line. For readline, this handles the "
"automatic indentation of code blocks."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of cmd.Cmd.postloop:2
msgid "Hook method executed once when the cmdloop() method is about to return."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.base_shell.BaseShell.precmd:2
msgid "Called just before execution of line."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of cmd.Cmd.preloop:2
msgid "Hook method executed once when the cmdloop() method is called."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineShell.print_color:2
msgid ""
"Prints a string in color. This base implementation's colors are based on "
"ANSI color codes if a string was given as input. If a list of token pairs is "
"given, it will color based on pygments, if available. If pygments is not "
"available, it will print a colorless string."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.base_shell.BaseShell.push:2
msgid ""
"Pushes a line onto the buffer and compiles the code in a way that enables "
"multiline input."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.base_shell.BaseShell.reset_buffer:2
msgid "Resets the line buffer."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineShell.restore_tty_sanity:2
msgid ""
"An interface for resetting the TTY stdin mode. This is highly dependent on "
"the shell backend. Also it is mostly optional since it only affects ^Z "
"backgrounding behaviour."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.base_shell.BaseShell.settitle:2
msgid "Sets terminal title."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineShell.singleline:2
msgid ""
"Reads a single line of input. The store_in_history kwarg flags whether the "
"input should be stored in readline's in-memory history."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.ReadlineShell.prompt:2
msgid "Obtains the current prompt string."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.fix_readline_state_after_ctrl_c:2
msgid "Fix to allow Ctrl-C to exit reverse-i-search."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.fix_readline_state_after_ctrl_c:4
msgid "Based on code from:"
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.fix_readline_state_after_ctrl_c:5
msgid "http://bugs.python.org/file39467/raw_input__workaround_demo.py"
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.rl_completion_query_items:2
msgid ""
"Sets the rl_completion_query_items variable, if possible. A None value will "
"set this to $COMPLETION_QUERY_LIMIT, otherwise any integer is accepted."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.rl_completion_suppress_append:2
msgid ""
"Sets the rl_completion_suppress_append variable, if possible. A value of 1 "
"(default) means to suppress, a value of 0 means to enable."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.rl_variable_dumper:2
msgid ""
"Dumps the currently set readline variables. If readable is True, then this "
"output may be used in an inputrc file."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.rl_variable_value:2
msgid "Returns the currently set value for a readline configuration variable."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.setup_readline:2
msgid "Sets up the readline module and completion suppression, if available."
msgstr ""

#: ../../../../xonsh/shells/readline_shell.py:docstring of
#: xonsh.shells.readline_shell.teardown_readline:2
msgid "Tears down up the readline module, if available."
msgstr ""
