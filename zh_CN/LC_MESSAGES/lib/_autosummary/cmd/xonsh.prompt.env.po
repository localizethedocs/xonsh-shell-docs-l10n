#: ../../../lib/_autosummary/cmd/xonsh.prompt.env.rst:2
msgid "xonsh.prompt.env"
msgstr ""

#: ../../../../xonsh/prompt/env.py:docstring of xonsh.prompt.env:1
msgid "Prompt formatter for virtualenv and others"
msgstr ""

#: ../../../../xonsh/prompt/env.py:docstring of xonsh.prompt.env.emit_osc7:2
msgid "Emit an OSC 7 escape sequence to report the current working directory."
msgstr ""

#: ../../../../xonsh/prompt/env.py:docstring of xonsh.prompt.env.emit_osc7:4
msgid ""
"Terminals use this for features like \"Open new tab in same directory\" and "
"macOS Terminal.app session restoration."
msgstr ""

#: ../../../../xonsh/prompt/env.py:docstring of xonsh.prompt.env.env_name:2
msgid "Build env_name based on different sources. Respect order of precedence."
msgstr ""

#: ../../../../xonsh/prompt/env.py:docstring of xonsh.prompt.env.env_name:4
msgid ""
"Name from ``$VIRTUAL_ENV_PROMPT`` is used as-is — so users can override the "
"prompt verbatim. As an exception, if the value matches the name derived from "
"``$VIRTUAL_ENV`` (via the ``prompt=`` field in ``pyvenv.cfg`` or the "
"directory basename), it is treated as a value auto-populated by ``activate."
"xsh`` and wrapped with ``{env_prefix}`` / ``{env_postfix}`` like the other "
"sources. Names from other sources are always surrounded with ``{env_prefix}"
"`` and ``{env_postfix}``."
msgstr ""

#: ../../../../xonsh/prompt/env.py:docstring of
#: xonsh.prompt.env.find_env_name:2
msgid "Find current environment name from available sources."
msgstr ""

#: ../../../../xonsh/prompt/env.py:docstring of
#: xonsh.prompt.env.find_env_name:4
msgid ""
"If ``$VIRTUAL_ENV`` is set, it is determined from the prompt setting in "
"``<venv>/pyvenv.cfg`` or from the folder name of the environment."
msgstr ""

#: ../../../../xonsh/prompt/env.py:docstring of
#: xonsh.prompt.env.find_env_name:7
msgid "Otherwise - if it is set - from ``$CONDA_DEFAULT_ENV``."
msgstr ""

#: ../../../../xonsh/prompt/env.py:docstring of
#: xonsh.prompt.env.vte_new_tab_cwd:2
msgid ""
"This prints an escape sequence that tells VTE terminals the hostname and "
"pwd. This should not be needed in most cases, but sometimes is for certain "
"Linux terminals that do not read the PWD from the environment on startup. "
"Note that this does not return a string, it simply prints and flushes the "
"escape sequence to stdout directly."
msgstr ""
