#: ../../../lib/_autosummary/cmd/xonsh.procs.pipes.rst:2
msgid "xonsh.procs.pipes"
msgstr ""

#: ../../../../xonsh/procs/pipes.py:docstring of xonsh.procs.pipes:1
msgid "Pipe channel for single-owner fd management."
msgstr ""

#: ../../../../xonsh/procs/pipes.py:docstring of
#: xonsh.procs.pipes.PipeChannel:2
msgid ""
"Single-owner pipe fd manager. Owner creates the pipe and is responsible for "
"closing both ends. Consumers get non-owning wrappers via open_writer() / "
"open_reader()."
msgstr ""

#: ../../../../xonsh/procs/pipes.py:docstring of
#: xonsh.procs.pipes.PipeChannel.from_pipe:2
msgid "Create a PipeChannel from os.pipe()."
msgstr ""

#: ../../../../xonsh/procs/pipes.py:docstring of
#: xonsh.procs.pipes.PipeChannel.from_pty:2
msgid "Create a PipeChannel from pty.openpty()."
msgstr ""

#: ../../../../xonsh/procs/pipes.py:docstring of
#: xonsh.procs.pipes.PipeChannel.from_pty:4
msgid "Falls back to os.pipe() if PTY devices are exhausted."
msgstr ""

#: ../../../../xonsh/procs/pipes.py:docstring of
#: xonsh.procs.pipes.PipeChannel.close:2
msgid "Close both ends."
msgstr ""

#: ../../../../xonsh/procs/pipes.py:docstring of
#: xonsh.procs.pipes.PipeChannel.close_reader:2
msgid "Close the read end fd. Thread-safe and idempotent."
msgstr ""

#: ../../../../xonsh/procs/pipes.py:docstring of
#: xonsh.procs.pipes.PipeChannel.close_writer:2
msgid "Close the write end fd. Thread-safe and idempotent."
msgstr ""

#: ../../../../xonsh/procs/pipes.py:docstring of
#: xonsh.procs.pipes.PipeChannel.open_reader:2
msgid "Non-owning file wrapper for the read end."
msgstr ""

#: ../../../../xonsh/procs/pipes.py:docstring of
#: xonsh.procs.pipes.PipeChannel.open_writer:2
msgid "Non-owning file wrapper for the write end."
msgstr ""
