#: ../../../launch.rst:5
msgid "Launch Options"
msgstr ""

#: ../../../launch.rst:7
msgid "Xonsh accepts the following command-line arguments:"
msgstr ""

#: ../../../launch.rst:9
msgid ""
"xonsh [-h] [-V] [-c COMMAND] [-n] [-i] [-l] [--rc RC [RC ...]]\n"
"      [--no-rc] [--no-env] [--no-script-cache] [--cache-everything]\n"
"      [-D ITEM] [-st SHELL_TYPE] [--timings]\n"
"      [--save-origin-env] [--load-origin-env]\n"
"      [script-file] [args ...]"
msgstr ""

#: ../../../launch.rst:18
msgid "Arguments Reference"
msgstr ""

#: ../../../launch.rst:20
msgid "``script-file``"
msgstr ""

#: ../../../launch.rst:21
msgid "If present, execute the script and exit."
msgstr ""

#: ../../../launch.rst:23
msgid "``args``"
msgstr ""

#: ../../../launch.rst:24
msgid "Additional arguments passed to the script."
msgstr ""

#: ../../../launch.rst:26
msgid "``-h``, ``--help``"
msgstr ""

#: ../../../launch.rst:27
msgid "Show help and exit."
msgstr ""

#: ../../../launch.rst:29
msgid "``-V``, ``--version``"
msgstr ""

#: ../../../launch.rst:30
msgid "Show version information and exit."
msgstr ""

#: ../../../launch.rst:32
msgid "``-c COMMAND``"
msgstr ""

#: ../../../launch.rst:33
msgid "Run a single command and exit."
msgstr ""

#: ../../../launch.rst:35
msgid "``-n``, ``--no-execute``"
msgstr ""

#: ../../../launch.rst:36
msgid ""
"Check syntax of the command, script, or stdin without running it. Exit non-"
"zero on errors.  See also the ``xonsh check`` subcommand."
msgstr ""

#: ../../../launch.rst:39
msgid "``-i``, ``--interactive``"
msgstr ""

#: ../../../launch.rst:40
msgid "Force running in interactive mode."
msgstr ""

#: ../../../launch.rst:42
msgid "``-l``, ``--login``"
msgstr ""

#: ../../../launch.rst:43
msgid "Run as a login shell."
msgstr ""

