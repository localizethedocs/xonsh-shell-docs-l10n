msgstr ""

#: ../../../launch.rst:49
msgid "``--no-rc``"
msgstr ""

#: ../../../launch.rst:50
msgid ""
"Do not load any xonsh RC files.  ``--rc`` is ignored when ``--no-rc`` is set."
msgstr ""

#: ../../../launch.rst:53
msgid "``--no-env``"
msgstr ""

#: ../../../launch.rst:54
msgid "Do not inherit parent environment variables."
msgstr ""

#: ../../../launch.rst:56
msgid "``--no-script-cache``"
msgstr ""

#: ../../../launch.rst:57
msgid "Do not cache scripts as they are run."
msgstr ""

#: ../../../launch.rst:59
msgid "``--cache-everything``"
msgstr ""

#: ../../../launch.rst:60
msgid "Use a cache, even for interactive commands."
msgstr ""

