#: ../../../aliases.rst:192
msgid "``@error_raise`` and ``@error_ignore``"
msgstr ""

#: ../../../aliases.rst:193
msgid ""
"Use ``@error_raise`` to raise an exception if the command returns a non-zero "
"exit code — similar to ``$XONSH_SUBPROC_CMD_RAISE_ERROR`` but scoped to a "
"single command, and it raises unconditionally (even inside ``&&``/``||`` "
"chains and even when ``$XONSH_SUBPROC_RAISE_ERROR`` is disabled).  Use "
"``@error_ignore`` to explicitly suppress the raise — it also wins over the "
"chain-result check performed by ``$XONSH_SUBPROC_RAISE_ERROR``."
msgstr ""

#: ../../../aliases.rst:200
msgid ""
"@ r = !(@error_raise ls nonono)\n"
"subprocess.CalledProcessError: Command '['@error_raise', 'ls', 'nonono']' "
"returned non-zero exit status 1.\n"
"\n"
"@ r = !(@error_ignore ls nonono)"
msgstr ""

