#: ../../../lib/_autosummary/helpers/xonsh.webconfig.main.rst:2
msgid "xonsh.webconfig.main"
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.address_string:2
msgid "Return the client address."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.SimpleHTTPRequestHandler.copyfile:2
msgid "Copy all data between two file objects."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.SimpleHTTPRequestHandler.copyfile:4
msgid ""
"The SOURCE argument is a file object open for reading (or anything with a "
"read() method) and the DESTINATION argument is a file object open for "
"writing (or anything with a write() method)."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.SimpleHTTPRequestHandler.copyfile:9
msgid ""
"The only reason for overriding this would be to change the block size or "
"perhaps to replace newlines by CRLF -- note however that this the default "
"server uses this to copy binary data as well."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.date_time_string:2
msgid "Return the current date and time formatted for a message header."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: xonsh.webconfig.main.XonshConfigHTTPRequestHandler.do_GET:2
msgid "Serve a GET request."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.SimpleHTTPRequestHandler.do_HEAD:2
msgid "Serve a HEAD request."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: xonsh.webconfig.main.XonshConfigHTTPRequestHandler.do_POST:2
msgid "Reads post request body"
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.end_headers:2
msgid "Send the blank line ending the MIME headers."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.SimpleHTTPRequestHandler.guess_type:2
msgid "Guess the type of a file."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.SimpleHTTPRequestHandler.guess_type:4
msgid "Argument is a PATH (a filename)."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.SimpleHTTPRequestHandler.guess_type:6
msgid ""
"Return value is a string of the form type/subtype, usable for a MIME Content-"
"type header."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.SimpleHTTPRequestHandler.guess_type:9
msgid ""
"The default implementation looks the file's extension up in the table self."
"extensions_map, using application/octet-stream as a default; however it "
"would be permissible (if slow) to look inside the data to make a better "
"guess."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.handle:2
msgid "Handle multiple requests if necessary."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.handle_expect_100:2
msgid "Decide what to do with an \"Expect: 100-continue\" header."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.handle_expect_100:4
msgid ""
"If the client is expecting a 100 Continue response, we must respond with "
"either a 100 Continue or a final response before waiting for the request "
"body. The default is to always respond with a 100 Continue. You can behave "
"differently (for example, reject unauthorized requests) by overriding this "
"method."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.handle_expect_100:10
msgid ""
"This method should either return True (possibly after sending a 100 Continue "
"response) or send an error response and return False."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.handle_one_request:2
msgid "Handle a single HTTP request."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.handle_one_request:4
msgid ""
"You normally don't need to override this method; see the class __doc__ "
"string for information on how to handle specific HTTP commands such as GET "
"and POST."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.SimpleHTTPRequestHandler.list_directory:2
msgid "Helper to produce a directory listing (absent index.html)."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.SimpleHTTPRequestHandler.list_directory:4
msgid ""
"Return value is either a file object, or None (indicating an error).  In "
"either case, the headers are sent, making the interface the same as for "
"send_head()."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.log_date_time_string:2
msgid "Return the current time formatted for logging."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.log_error:2
msgid "Log an error."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.log_error:4
msgid ""
"This is called when a request cannot be fulfilled.  By default it passes the "
"message on to log_message()."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.log_error:7
msgid "Arguments are the same as for log_message()."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.log_error:9
msgid "XXX This should go to the separate error log."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.log_message:2
msgid "Log an arbitrary message."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.log_message:4
msgid ""
"This is used by all other logging functions.  Override it if you have "
"specific logging wishes."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.log_message:7
msgid ""
"The first argument, FORMAT, is a format string for the message to be "
"logged.  If the format string contains any % escapes requiring parameters, "
"they should be specified as subsequent arguments (it's just like printf!)."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.log_message:13
msgid "The client ip and current date/time are prefixed to every message."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.log_message:16
msgid ""
"Unicode control characters are replaced with escaped hex before writing the "
"output to stderr."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.log_request:2
msgid "Log an accepted request."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.log_request:4
msgid "This is called by send_response()."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.parse_request:2
msgid "Parse a request (internal)."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.parse_request:4
msgid ""
"The request should be stored in self.raw_requestline; the results are in "
"self.command, self.path, self.request_version and self.headers."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.parse_request:8
msgid ""
"Return True for success, False for failure; on failure, any relevant error "
"response has already been sent back."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.send_error:2
msgid "Send and log an error reply."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.send_error:4
msgid "Arguments are * code:    an HTTP error code"
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.send_error:6
msgid "3 digits"
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.send_error:7
msgid "message: a simple optional 1 line reason phrase."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.send_error:8
msgid ""
"*( HTAB / SP / VCHAR / %x80-FF ) defaults to short entry matching the "
"response code"
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.send_error:10
msgid "explain: a detailed message defaults to the long entry"
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.send_error:11
msgid "matching the response code."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.send_error:13
msgid ""
"This sends an error response (so it must be called before any output has "
"been generated), logs the error, and finally sends a piece of HTML "
"explaining the error to the user."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.SimpleHTTPRequestHandler.send_head:2
msgid "Common code for GET and HEAD commands."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.SimpleHTTPRequestHandler.send_head:4
msgid "This sends the response code and MIME headers."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.SimpleHTTPRequestHandler.send_head:6
msgid ""
"Return value is either a file object (which has to be copied to the "
"outputfile by the caller unless the command was HEAD, and must be closed by "
"the caller under all circumstances), or None, in which case the caller has "
"nothing further to do."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.send_header:2
msgid "Send a MIME header to the headers buffer."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.send_response:2
msgid ""
"Add the response header to the headers buffer and log the response code."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.send_response:5
msgid ""
"Also send two standard headers with the server software version and the "
"current date."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.send_response_only:2
msgid "Send the response header only."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.SimpleHTTPRequestHandler.translate_path:2
msgid "Translate a /-separated PATH to the local filename syntax."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.SimpleHTTPRequestHandler.translate_path:4
msgid ""
"Components that mean special things to the local file system (e.g. drive or "
"directory names) are ignored.  (XXX They should probably be diagnosed.)"
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of
#: http.server.BaseHTTPRequestHandler.version_string:2
msgid "Return the server software version string."
msgstr ""

#: ../../../../xonsh/webconfig/main.py:docstring of xonsh.webconfig.main.main:2
msgid "standalone entry point for webconfig."
msgstr ""
