#: ../../../history_backend.rst:5
msgid "History Backend"
msgstr ""

#: ../../../history_backend.rst:7
msgid ""
"One of the great things about xonsh is how easy it is to customize. In this "
"tutorial, let's write our own history backend based on CouchDB."
msgstr ""

#: ../../../history_backend.rst:12
msgid "Start with a Minimal History Template"
msgstr ""

#: ../../../history_backend.rst:14
msgid "Here is a minimal history backend to start with:"
msgstr ""

#: ../../../history_backend.rst:16
msgid ""
"import collections\n"
"from xonsh.history.base import History\n"
"\n"
"class CouchDBHistory(History):\n"
"    def append(self, cmd):\n"
"        pass\n"
"\n"
"    def items(self, newest_first=False):\n"
"        yield {'inp': 'couchdb in action', 'ts': 1464652800, 'ind': 0}\n"
"\n"
"    def all_items(self, newest_first=False):\n"
"        return self.items()\n"
"\n"
"    def info(self):\n"
"        data = collections.OrderedDict()\n"
"        data['backend'] = 'couchdb'\n"
"        data['sessionid'] = str(self.sessionid)\n"
"        return data"
msgstr ""

#: ../../../history_backend.rst:37
msgid ""
"Go ahead and create the file ``~/.xonsh/history_couchdb.py`` and put the "
"content above into it."
msgstr ""

#: ../../../history_backend.rst:40
msgid ""
"Now we need to tell xonsh to use it as the history backend. To do this we "
"need xonsh to be able to find our file and this ``CouchDBHistory`` class. "
"Putting the following code into your :doc:`xonsh RC <xonshrc>` can achieve "
"this."
msgstr ""

#: ../../../history_backend.rst:44
msgid ""
"import os.path\n"
"import sys\n"
"xonsh_ext_dir = os.path.expanduser('~/.xonsh')\n"
"if os.path.isdir(xonsh_ext_dir):\n"
"    sys.path.append(xonsh_ext_dir)\n"
"\n"
"from history_couchdb import CouchDBHistory\n"
"$XONSH_HISTORY_BACKEND = CouchDBHistory"
msgstr ""

#: ../../../history_backend.rst:55
msgid "After starting a new xonsh session, try the following commands:"
msgstr ""

#: ../../../history_backend.rst:57
msgid ""
"@ history info\n"
"backend: couchdb\n"
"sessionid: 4198d678-1f0a-4ce3-aeb3-6d5517d7fc61\n"
"\n"
"@ history -n\n"
"0: couchdb in action"
msgstr ""

#: ../../../history_backend.rst:66
msgid "Woohoo! We just wrote a working history backend!"
msgstr ""

