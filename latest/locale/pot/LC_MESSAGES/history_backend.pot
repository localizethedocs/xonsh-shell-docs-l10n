msgstr ""

#: ../../../history_backend.rst:103
msgid "Initialize History Backend"
msgstr ""

#: ../../../history_backend.rst:105
msgid ""
"def __init__(self, **kwargs):\n"
"    super().__init__(**kwargs)\n"
"    self.gc = None\n"
"    self.sessionid = self._build_session_id()\n"
"    self.inps = []\n"
"    self.rtns = []\n"
"    self.outs = []\n"
"    self.tss = []\n"
"\n"
"def _build_session_id(self):\n"
"    ts = int(time.time() * 1000)\n"
"    return '{}-{}'.format(ts, str(uuid.uuid4())[:18])"
msgstr ""

#: ../../../history_backend.rst:120
msgid ""
"In the ``__init__()`` method, let's initialize `Some Public Attributes <api/"
"history/base.html#xonsh.history.base.History>`_ which xonsh uses in various "
"places. Note that we use Unix timestamp and some random char to make ``self."
"sessionid`` unique and to keep the entries ordered in time. We will cover it "
"with a bit more detail in the next section."
msgstr ""

#: ../../../history_backend.rst:128
msgid "Save History to CouchDB"
msgstr ""

#: ../../../history_backend.rst:130
msgid "First, we need some helper functions to write docs to CouchDB."
msgstr ""

#: ../../../history_backend.rst:132
msgid ""
"def _save_to_db(self, cmd):\n"
"    data = cmd.copy()\n"
"    data['inp'] = cmd['inp'].rstrip()\n"
"    if 'out' in data:\n"
"        data.pop('out')\n"
"    data['_id'] = self._build_doc_id()\n"
"    try:\n"
"        self._request_db_data('/xonsh-history', data=data)\n"
"    except Exception as e:\n"
"        msg = 'failed to save history: {}: {}'.format(e.__class__.__name__, "
"e)\n"
"        print(msg, file=sys.stderr)\n"
"\n"
"def _build_doc_id(self):\n"
"    ts = int(time.time() * 1000)\n"
"    return '{}-{}-{}'.format(self.sessionid, ts, str(uuid.uuid4())[:18])\n"
"\n"
"def _request_db_data(self, path, data=None):\n"
"    url = 'http://127.0.0.1:5984' + path\n"
"    headers = {'Content-Type': 'application/json'}\n"
"    if data is not None:\n"
"        resp = requests.post(url, json.dumps(data), headers=headers)\n"
"    else:\n"
"        headers = {'Content-Type': 'text/plain'}\n"
"        resp = requests.get(url, headers=headers)\n"
"    return resp"
msgstr ""

#: ../../../history_backend.rst:160
msgid ""
"``_save_to_db()`` takes a dict as the input, which contains the information "
"about a command that user input, and saves it into CouchDB."
msgstr ""

#: ../../../history_backend.rst:163
msgid ""
"Instead of letting CouchDB provide us a random Document ID (i.e. the "
"``data['_id']`` in our code), we build it for ourselves.  We use the Unix "
"timestamp and UUID string for a second time. Prefixing this with ``self."
"sessionid``, we make history entries in order inside a single xonsh session "
"too. So that we don't need any extra CouchDB's `Design Documents and Views "
"<http://docs.couchdb.org/en/2.0.0/couchapp/ddocs.html>`_ feature. Just with "
"a bare ``_all_docs`` API, we can fetch history items back in order."
msgstr ""

#: ../../../history_backend.rst:172
msgid ""
"Now that we have helper functions, let's update our ``append()`` method to "
"do the real job - save history into DB."
msgstr ""

#: ../../../history_backend.rst:175
msgid ""
"def append(self, cmd):\n"
"    self.inps.append(cmd['inp'])\n"
"    self.rtns.append(cmd['rtn'])\n"
"    self.outs.append(None)\n"
"    self.tss.append(cmd.get('ts', (None, None)))\n"
"    self._save_to_db(cmd)"
msgstr ""

#: ../../../history_backend.rst:184
msgid ""
"This method will be called by xonsh every time it runs a new command from "
"user."
msgstr ""

#: ../../../history_backend.rst:188
msgid "Retrieve History Items"
msgstr ""

#: ../../../history_backend.rst:190
msgid ""
"def items(self, newest_first=False):\n"
"    yield from self._get_db_items(self.sessionid)\n"
"\n"
"def all_items(self, newest_first=False):\n"
"    yield from self._get_db_items()"
msgstr ""

#: ../../../history_backend.rst:198
msgid ""
"These two methods are responsible for getting history items for the current "
"xonsh session and all historical sessions respectively."
msgstr ""

#: ../../../history_backend.rst:201
msgid "And here is our helper method to get docs from DB:"
msgstr ""

#: ../../../history_backend.rst:203
msgid ""
"def _get_db_items(self, sessionid=None):\n"
"    path = '/xonsh-history/_all_docs?include_docs=true'\n"
"    if sessionid is not None:\n"
"        path += '&start_key=\"{0}\"&end_key=\"{0}-z\"'.format(sessionid)\n"
"    try:\n"
"        r = self._request_db_data(path)\n"
"    except Exception as e:\n"
"        msg = 'error when query db: {}: {}'.format(e.__class__.__name__, e)\n"
"        print(msg, file=sys.stderr)\n"
"        return\n"
"    data = json.loads(r.text)\n"
"    for item in data['rows']:\n"
"        cmd = item['doc'].copy()\n"
"        cmd['ts'] = cmd['ts'][0]\n"
"        yield cmd"
msgstr ""

#: ../../../history_backend.rst:221
msgid ""
"The `try-except` is here so that we're safe when something bad happens, like "
"CouchDB is not running properly, etc."
msgstr ""

#: ../../../history_backend.rst:226
msgid "Try Out Our New History Backend"
msgstr ""

#: ../../../history_backend.rst:228
msgid ""
"That's it. We've finished our new history backend. The ``import`` part is "
"skipped, but I think you can figure it out though. Note that in our code an "
"extra Python library is used: ``requests``. You could easily install it with "
"``pip`` or other library managers. You can find the full code here: "
"`<https://gist.github.com/mitnk/2d08dc60aab33d8b8b758c544b37d570>`_"
msgstr ""

