#: ../../../developer.rst:20
msgid "Terminal-based workflow"
msgstr ""

#: ../../../developer.rst:22
msgid "The simplified terminal-based workflow to contribute to xonsh:"
msgstr ""

#: ../../../developer.rst:24
msgid ""
"mkdir -p ~/git && cd ~/git\n"
"# For example your name is `snail` and you forked https://github.com/xonsh/"
"xonsh on Github\n"
"git clone git@github.com:snail/xonsh.git\n"
"# You can setup IDE (see next section) to extremely speed up the work and "
"test.\n"
"cd xonsh\n"
"\n"
"# Set git user name. Without `--global` it will work in local repository.\n"
"git config user.name \"Snail\"\n"
"git config user.email \"snail@email.com\"\n"
"\n"
"# Create your feature or fix branch.\n"
"git checkout -b my_awesome_feature\n"
"\n"
"# Install dev packages.\n"
"# python -m ensurepip --upgrade  # install pip if you have python without "
"pip\n"
"pip install -U pip\n"
"pip install '.[dev]' '.[doc]'\n"
"\n"
"# Make changes: add new environment variable.\n"
"vim xonsh/environ.py\n"
"git add xonsh/environ.py\n"
"\n"
"# Create test.\n"
"vim tests/environ.py\n"
"python -m pytest\n"
"\n"
"# Live test.\n"
"python -m xonsh --no-rc\n"
"\n"
"# Push\n"
"git commit -m \"My new environment variable!\"\n"
"git push\n"
"\n"
"# Open https://github.com/xonsh/xonsh/pulls\n"
"# Use green button to open Pull Request (PR)\n"
"# Use Conventional Commits naming e.g.\n"
"# \"feat: New env variable $SNAIL\""
msgstr ""

#: ../../../developer.rst:65
msgid "IDE-based workflow"
msgstr ""

#: ../../../developer.rst:67
msgid "You can also use IDE like PyCharm:"
msgstr ""

#: ../../../developer.rst:69
msgid "Install IDE e.g. `PyCharm <https://www.jetbrains.com/pycharm/>`_."
msgstr ""

#: ../../../developer.rst:70
msgid ""
"Go to ``File -> Project from Version Control -> URL`` https://github.com/"
"xonsh/xonsh"
msgstr ""

#: ../../../developer.rst:71
msgid "Go to the terminal and update pip and install full dependencies:"
msgstr ""

#: ../../../developer.rst:73
msgid ""
"# Run from PyCharm terminal with appropriate environment.\n"
"python -m pip install -U pip  # you need pip >= 24\n"
"python -m pip install '.[full]' '.[dev]' '.[doc]'"
msgstr ""

#: ../../../developer.rst:79
msgid "Setup IDE e.g. PyCharm:"
msgstr ""

#: ../../../developer.rst:81
msgid ""
"Create project based on xonsh code directory.\n"
"Click \"Run\" - \"Run...\" - \"Edit Configurations\"\n"
"Click \"+\" and choose \"Python\". Set:\n"
"    Name: \"xonsh --no-rc\".\n"
"    Run: choose \"module\" and write \"xonsh\".\n"
"    Script parameters: \"--no-rc -DFROM=PYCHARM\" (here \"FROM\" will help "
"to identify process using `ps ax | grep PYCHARM`).\n"
"    Working directory: \"/tmp\"  # to avoid corrupting the source code "
"during experiments\n"
"    Environment variables: add \";XONSH_SHOW_TRACEBACK=1\"\n"
"    Modify options: click \"Emulate terminal in output console\".\n"
"Save settings.\n"
"\n"
"Open `xonsh/procs/specs.py` and `def run_subproc` function.\n"
"Put breakpoint to `specs = cmds_to_specs` code. See also: https://www."
"jetbrains.com/help/pycharm/using-breakpoints.html\n"
"Click \"Run\" - \"Debug...\" - \"xonsh\". Now you can see xonsh prompt.\n"
"Run `echo 1` and now you're in the debug mode on the breakpoint.\n"
"Press F8 to step forward. Good luck!"
msgstr ""

