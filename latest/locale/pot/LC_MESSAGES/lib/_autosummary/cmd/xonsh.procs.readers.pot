"Returns whether or not the queue is fully read and the reader is closed."
msgstr ""

#: ../../../../xonsh/procs/readers.py:docstring of
#: xonsh.procs.readers.QueueReader.iterqueue:2
msgid "Iterates through all remaining chunks in a blocking fashion."
msgstr ""

#: ../../../../xonsh/procs/readers.py:docstring of
#: xonsh.procs.readers.QueueReader.read:2
msgid "Reads bytes from the file."
msgstr ""

#: ../../../../xonsh/procs/readers.py:docstring of
#: xonsh.procs.readers.QueueReader.read_queue:2
msgid ""
"Reads a single chunk from the queue. This is blocking if the timeout is None "
"and non-blocking otherwise."
msgstr ""

#: ../../../../xonsh/procs/readers.py:docstring of
#: xonsh.procs.readers.QueueReader.readline:2
msgid "Reads a line, or a partial line from the file descriptor."
msgstr ""

#: ../../../../xonsh/procs/readers.py:docstring of
#: xonsh.procs.readers.QueueReader.readlines:2
msgid ""
"Reads lines from the file descriptor. This is blocking for negative hints (i."
"e. read all the remaining lines) and non-blocking otherwise."
msgstr ""

#: ../../../../xonsh/procs/readers.py:docstring of
#: xonsh.procs.readers.NonBlockingFDReader:2
msgid ""
"A class for reading characters from a file descriptor on a background "
"thread. This has the advantages that the calling thread can close the file "
"and that the reading does not block the calling thread."
msgstr ""

#: ../../../../xonsh/procs/readers.py:docstring of
#: xonsh.procs.readers.NonBlockingFDReader:31
#: xonsh.procs.readers.QueueReader:29
msgid "A file descriptor"
msgstr ""

#: ../../../../xonsh/procs/readers.py:docstring of
#: xonsh.procs.readers.NonBlockingFDReader:-1
#: xonsh.procs.readers.QueueReader:-1
msgid "float or None, optional"
msgstr ""

#: ../../../../xonsh/procs/readers.py:docstring of
#: xonsh.procs.readers.QueueReader:2
msgid "Provides a file-like interface to reading from a queue."
msgstr ""

#: ../../../../xonsh/procs/readers.py:docstring of
#: xonsh.procs.readers.populate_buffer:2
msgid "Reads bytes from the file descriptor and copies them into a buffer."
msgstr ""

#: ../../../../xonsh/procs/readers.py:docstring of
#: xonsh.procs.readers.populate_buffer:4
msgid ""
"The reads happen in parallel using the pread() syscall; which is only "
"available on POSIX systems. If the read fails for any reason, the reader is "
"flagged as closed."
msgstr ""

#: ../../../../xonsh/procs/readers.py:docstring of
#: xonsh.procs.readers.populate_console:2
msgid ""
"Reads bytes from the file descriptor and puts lines into the queue. The "
"reads happened in parallel, using xonsh.winutils."
"read_console_output_character(), and is thus only available on windows. If "
"the read fails for any reason, the reader is flagged as closed."
msgstr ""

#: ../../../../xonsh/procs/readers.py:docstring of
#: xonsh.procs.readers.populate_fd_queue:2
msgid ""
"Reads 1 kb of data from a file descriptor into a queue. If this ends or "
"fails, it flags the calling reader object as closed."
msgstr ""

#: ../../../../xonsh/procs/readers.py:docstring of
#: xonsh.procs.readers.safe_fdclose:2
msgid ""
"Closes a file handle in the safest way possible, and potentially storing the "
"result."
msgstr ""
