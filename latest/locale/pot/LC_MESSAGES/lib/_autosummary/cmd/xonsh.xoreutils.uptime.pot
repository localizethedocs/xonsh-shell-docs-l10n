msgid "xonsh.xoreutils.uptime"
msgstr ""

#: ../../../../xonsh/xoreutils/uptime.py:docstring of xonsh.xoreutils.uptime:1
msgid "Provides a cross-platform way to figure out the system uptime."
msgstr ""

#: ../../../../xonsh/xoreutils/uptime.py:docstring of xonsh.xoreutils.uptime:3
msgid ""
"Should work on damned near any operating system you can realistically expect "
"to be asked to write Python code for. If this module is invoked as a stand-"
"alone script, it will print the current uptime in a human-readable format, "
"or display an error message if it can't, to standard output."
msgstr ""

#: ../../../../xonsh/xoreutils/uptime.py:docstring of xonsh.xoreutils.uptime:9
