#: ../../../eventsbody:527
msgid "``on_transform_command(cmd: str) -> str | None``"
msgstr ""

#: ../../../eventsbody:528
msgid ""
"Fired to request xontribs to transform a command line. Return the "
"transformed command, or the same command if no transformation occurs. Return "
"None to indicate no transformation (equivalent to returning the original "
"command). Only done for interactive sessions."
msgstr ""

#: ../../../eventsbody:533
msgid ""
"This may be fired multiple times per command, with other transformers input "
"or output, so design any handlers for this carefully."
msgstr ""

#: ../../../eventsbody:536
msgid ""
"@events.on_transform_command\n"
"def _pipe_prev_command(cmd, **kw):\n"
"    '''Pipe prev command e.g. `| grep 1` will be `<prev cmd> | grep 1`.'''\n"
"    if cmd and cmd.startswith('| ') and __xonsh__.history:\n"
"        return __xonsh__.history[-1].cmd.rstrip() + cmd.rstrip()\n"
"    return cmd"
msgstr ""

