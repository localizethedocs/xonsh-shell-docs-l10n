#: ../../../eventsbody:264
msgid "``on_lscolors_change(key: str, oldvalue: Any, newvalue: Any) -> None``"
msgstr ""

#: ../../../eventsbody:265
msgid ""
"Fires after a value in LS_COLORS changes, when a new key is added (oldvalue "
"is None) or when an existing key is deleted (newvalue is None). LS_COLORS "
"values must be (ANSI color) strings, None is unambiguous. Does not fire when "
"the whole environment variable changes (see on_envvar_change). Does not fire "
"for each value when LS_COLORS is first instantiated. Normal usage is to arm "
"the event handler, then read (not modify) all existing values."
msgstr ""

#: ../../../eventsbody:274
msgid ""
"``key``: The LS_COLORS key that changed (e.g. ``\"di\"`` for directories)."
msgstr ""

#: ../../../eventsbody:275
msgid ""
"``oldvalue``: Previous ANSI color string, or ``None`` if the key is new."
msgstr ""

#: ../../../eventsbody:276
msgid ""
"``newvalue``: New ANSI color string, or ``None`` if the key was deleted."
msgstr ""

#: ../../../eventsbody:280
msgid ""
"@events.on_lscolors_change\n"
"def _event_log_lscolors_change(key, oldvalue, newvalue, **kw):\n"
"    if newvalue is None:\n"
"        print(f\"LS_COLORS: removed key {key!r}\")\n"
"    elif oldvalue is None:\n"
"        print(f\"LS_COLORS: added {key!r}={newvalue!r}\")\n"
"    else:\n"
"        print(f\"LS_COLORS: changed {key!r} from {oldvalue!r} to {newvalue!"
"r}\")"
msgstr ""

