#: ../../../eventsbody:42
msgid "Fires when the current directory is changed for any reason."
msgstr ""

#: ../../../eventsbody:44
msgid ""
"@events.on_chdir\n"
"def _source_env_xsh(olddir, newdir):\n"
"    '''Source `env.xsh` file if it's exist in the new directory.'''\n"
"    env_file = @.imp.pathlib.Path(newdir) / 'env.xsh'\n"
"    if env_file.exists():\n"
"        print(f'Source {env_file}')\n"
"        source @(env_file)"
