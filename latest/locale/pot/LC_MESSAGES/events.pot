#: ../../../eventsbody:59
msgid ""
"``on_command_not_found(cmd: list[str]) -> list[str] | tuple[str, ...] | dict "
"| None``"
msgstr ""

#: ../../../eventsbody:60
msgid "Fires if a command is not found (only in interactive sessions)."
msgstr ""

#: ../../../eventsbody:62 ../../../eventsbody:104 ../../../eventsbody:156
#: ../../../eventsbody:179 ../../../eventsbody:272 ../../../eventsbody:371
#: ../../../eventsbody:466 ../../../eventsbody:491
msgid "Parameters:"
msgstr ""

#: ../../../eventsbody:64
msgid "``cmd``: The command that was attempted"
msgstr ""

#: ../../../eventsbody:66
msgid "Returns:"
msgstr ""

#: ../../../eventsbody:68
msgid ""
"``list[str]`` or ``tuple[str, ...]``: A replacement command to execute "
"instead. The first valid replacement from any handler will be used."
msgstr ""

#: ../../../eventsbody:70
msgid ""
"``dict``: A dict with a required ``\"cmd\"`` key (list of command tokens) "
"and an optional ``\"env\"`` key (dict of environment variables to set for "
"the replacement command). Same convention as ``@Aliases.return_command``."
msgstr ""

#: ../../../eventsbody:73
msgid "``None``: To let the error be raised normally"
msgstr ""

#: ../../../eventsbody:75
msgid ""
"Note: If the replacement command also fails, the original error is shown."
msgstr ""

#: ../../../eventsbody:77
msgid "Examples:"
msgstr ""

#: ../../../eventsbody:79
msgid ""
"@events.on_command_not_found\n"
"def _vim_to_vi(cmd, **kwargs):\n"
"    '''If vim not found let's try to use vi.'''\n"
"    if cmd[0] == 'vim':\n"
"        return ['vi'] + cmd[1:]\n"
"\n"
"@events.on_command_not_found\n"
"def _node_with_path(cmd, **kwargs):\n"
"    '''Run node with a custom NODE_PATH.'''\n"
"    if cmd[0] == 'mynode':\n"
"        return {\"cmd\": [\"node\"] + cmd[1:], \"env\": {\"NODE_PATH\": \"/"
"opt/libs\"}}"
msgstr ""

#: ../../../eventsbody:98
msgid ""
"``on_completer_filter(completer: str, command: str, context: "
"CompletionContext) -> bool | None``"
msgstr ""

#: ../../../eventsbody:99
msgid ""
"Fires once for every registered completer just before it is invoked, "
"allowing handlers to veto the call. Return ``False`` to skip the completer; "
"return ``True``, ``None`` (or nothing) to let it run. If any handler returns "
"``False``, the completer is skipped."
msgstr ""

#: ../../../eventsbody:106
msgid ""
"``completer``: the registered name of the completer about to run (e.g. "
"``'bash'``, ``'path'``)."
msgstr ""

#: ../../../eventsbody:108
msgid ""
"``command``: the basename of the command being completed (e.g. ``'kubectl'`` "
"even when the user typed ``/usr/bin/kubectl``). Empty string when no command "
"has been typed yet, or when the completion happens outside the command-line "
"context."
msgstr ""

#: ../../../eventsbody:112
msgid ""
"``context``: the full :class:`CompletionContext` for the current completion "
"request."
msgstr ""

#: ../../../eventsbody:115
msgid ""
"Use this to short-circuit completers such as ``bash`` on commands where the "
"user does not need bash-supplied completions:"
msgstr ""

#: ../../../eventsbody:118
msgid ""
"@events.on_completer_filter\n"
"def _only_bash_for_some(completer, command, context, **_):\n"
"    return command in {'kubectl', 'docker'} if completer == 'bash' else True"
msgstr ""

#: ../../../eventsbody:124
msgid ""
"Handlers run on the completion thread; exceptions raised inside a handler "
"are logged and treated as if no value was returned (i.e. the completer is "
"still allowed to run)."
msgstr ""

#: ../../../eventsbody:133
msgid "``on_envvar_change(name: str, oldvalue: Any, newvalue: Any) -> None``"
msgstr ""

#: ../../../eventsbody:134
msgid ""
"Fires after an environment variable is changed. Note: Setting envvars inside "
"the handler might cause a recursion until the limit."
msgstr ""

#: ../../../eventsbody:138
msgid ""
"@events.on_envvar_change\n"
"def _on_env_path_change(name, oldvalue, newvalue):\n"
"    '''Keep `/tmp/bin` on top of PATH.'''\n"
"    if name == 'PATH' and (newvalue == [] or newvalue[0] != '/tmp/bin'):\n"
"        $PATH = ['/tmp/bin'] + [v for v in newvalue if v != '/tmp/bin']"
msgstr ""

