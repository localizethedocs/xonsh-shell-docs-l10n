#: ../../../../xonsh/tools.py:docstring of xonsh.tools.replace_logical_line:2
msgid ""
"Replaces lines at idx that may end in line continuation with a logical line "
"that spans n lines."
msgstr ""

#: ../../../../xonsh/tools.py:docstring of xonsh.tools.replace_logical_line:5
msgid ""
"When the logical line contains a real ``\\n`` — i.e. it came from a triple-"
"quoted string that ``splitlines()`` cut in the middle — the original "
"physical split is not meaningful (it sliced inside the string literal).  "
"Collapse the affected slot to a single list entry so the downstream "
"``\"\\n\".join(lines)`` reproduces the input exactly without inserting extra "
"newlines or splitting on whitespace inside the literal."
msgstr ""

#: ../../../../xonsh/tools.py:docstring of xonsh.tools.safe_hasattr:2
