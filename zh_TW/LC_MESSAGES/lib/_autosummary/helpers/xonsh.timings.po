#: ../../../../xonsh/timings.py:docstring of xonsh.timings.Timer:2
msgid ""
"Timer class that explicitly uses self.inner which is an undocumented "
"implementation detail of CPython, not shared by PyPy."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of xonsh.timings.Timer:25
msgid "Constructor.  See class doc string."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of timeit.Timer.autorange:2
msgid "Return the number of loops and time taken so that total time >= 0.2."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of timeit.Timer.autorange:4
msgid ""
"Calls the timeit method with increasing numbers from the sequence 1, 2, 5, "
"10, 20, 50, ... until the time taken is at least 0.2 second.  Returns "
"(number, time_taken)."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of timeit.Timer.autorange:8
msgid ""
"If *callback* is given and is not None, it will be called after each trial "
"with two arguments: ``callback(number, time_taken)``."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of timeit.Timer.print_exc:2
msgid "Helper to print a traceback from the timed code."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of timeit.Timer.print_exc:4
msgid "Typical use:"
msgstr ""

#: ../../../../xonsh/timings.py:docstring of timeit.Timer.print_exc:6
msgid "t = Timer(...)       # outside the try/except try:"
msgstr ""

#: ../../../../xonsh/timings.py:docstring of timeit.Timer.print_exc:8
msgid "t.timeit(...)    # or t.repeat(...)"
msgstr ""

#: ../../../../xonsh/timings.py:docstring of timeit.Timer.print_exc:9
msgid "except:"
msgstr ""

#: ../../../../xonsh/timings.py:docstring of timeit.Timer.print_exc:10
msgid "t.print_exc()"
msgstr ""

#: ../../../../xonsh/timings.py:docstring of timeit.Timer.print_exc:12
msgid ""
"The advantage over the standard traceback is that source lines in the "
"compiled template will be displayed."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of timeit.Timer.print_exc:15
msgid ""
"The optional file argument directs where the traceback is sent; it defaults "
"to sys.stderr."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of timeit.Timer.repeat:2
msgid "Call timeit() a few times."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of timeit.Timer.repeat:4
msgid ""
"This is a convenience function that calls the timeit() repeatedly, returning "
"a list of results.  The first argument specifies how many times to call "
"timeit(), defaulting to 5; the second argument specifies the timer argument, "
"defaulting to one million."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of timeit.Timer.repeat:10
msgid ""
"Note: it's tempting to calculate mean and standard deviation from the result "
"vector and report these.  However, this is not very useful.  In a typical "
"case, the lowest value gives a lower bound for how fast your machine can run "
"the given code snippet; higher values in the result vector are typically not "
"caused by variability in Python's speed, but by other processes interfering "
"with your timing accuracy.  So the min() of the result is probably the only "
"number you should be interested in.  After that, you should look at the "
"entire vector and apply common sense rather than statistics."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of xonsh.timings.Timer.timeit:2
msgid ""
"Time 'number' executions of the main statement. To be precise, this executes "
"the setup statement once, and then returns the time it takes to execute the "
"main statement a number of times, as a float measured in seconds.  The "
"argument is the number of times through the loop, defaulting to one "
"million.  The main statement, the setup statement and the timer function to "
"be used are passed to the constructor."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of
#: xonsh.timings.clock.<locals>.clock:2
msgid ""
"Return the *TOTAL USER+SYSTEM* CPU time in seconds since the start of the "
"process."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of
#: xonsh.timings.clock2.<locals>.clock2:2
msgid "Similar to clock(), but return a tuple of user/system times."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of
#: xonsh.timings.clocks.<locals>.clocks:2
msgid "Return the *SYSTEM* CPU time in seconds since the start of the process."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of
#: xonsh.timings.clocku.<locals>.clocku:2
msgid "Return the *USER* CPU time in seconds since the start of the process."
msgstr ""

#: ../../../../xonsh/timings.py:docstring of xonsh.timings.format_time:2
msgid "Formats the timespan in a human readable form"
msgstr ""

