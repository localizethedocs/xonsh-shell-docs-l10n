#: ../../../lib/_autosummary/helpers/xonsh.platform.rst:2
msgid "xonsh.platform"
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform:1
msgid ""
"Module for platform-specific constants and implementations, as well as "
"compatibility layers to make use of the 'best' implementation available on a "
"platform."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.bash_command:2
msgid "Determines the command for Bash on the current platform."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of
#: xonsh.platform.git_for_windows_path:2
msgid "Returns the path to git for windows, if available and None otherwise."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.githash:2
msgid "Returns a tuple contains two strings: the hash and the date."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of
#: xonsh.platform.has_prompt_toolkit:2
msgid "Tests if the `prompt_toolkit` is available."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of
#: xonsh.platform.is_readline_available:2
msgid "Checks if readline is available to import."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.linux_distro:2
msgid ""
"The id of the Linux distribution running on, possibly 'unknown'. None on non-"
"Linux platforms."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.path_bshell:2
msgid "Absolute path to the system Bourne shell, like libc ``_PATH_BSHELL``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.path_bshell:4
msgid ""
"``/bin/sh`` everywhere except Android: Termux ships ``sh`` under ``$PREFIX/"
"bin`` and stock Android under ``/system/bin`` (bionic's ``_PATH_BSHELL``); "
"plain ``/bin/sh`` may not exist on either. Candidates are checked for "
"existence, so FHS userlands running on top of Android (proot-distro, "
"UserLAnd, ...) keep their own ``/bin/sh``. NixOS needs no special casing — "
"``/bin/sh`` is its single ``/bin`` FHS concession. If no candidate exists, "
"fall back to ``sh`` from ``$PATH`` (POSIX mandates the *utility*, not a "
"fixed path)."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.pathbasename:2
msgid ""
"This is a safe version of os.path.basename(), which does not work on input "
"without a drive.  This version does."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.pathsplit:2
msgid ""
"This is a safe version of os.path.split(), which does not work on input "
"without a drive."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ptk_version:2
msgid "Returns `prompt_toolkit.__version__` if available, else ``None``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ptk_version_info:2
msgid "Returns `prompt_toolkit`'s version as tuple of integers."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.pygments_version:2
msgid "pygments.__version__ version if available, else None."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of
#: xonsh.platform.pygments_version_info:2
msgid "Returns `pygments`'s version as tuple of integers."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of
#: xonsh.platform.windows_bash_command:2
msgid "Determines the command for Bash on windows."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of
#: xonsh.platform.windows_expanduser:2
msgid ""
"A Windows-specific expanduser() function for xonsh. This is needed since os."
"path.expanduser() does not check on Windows if the user actually exists. "
"This restricts expanding the '~' if it is not followed by a separator. That "
"is only '~/' and '~' are expanded."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of
#: xonsh.platform.CAN_RESIZE_WINDOW:2
msgid ""
"``True`` if we can resize terminal window, as provided by the presense of "
"signal.SIGWINCH, else ``False``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.DEFAULT_ENCODING:2
msgid "Default string encoding."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.IN_APPIMAGE:2
msgid "``True`` if in AppImage, else ``False``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.IN_FLATPAK:2
msgid "``True`` if in Flastpak, else ``False``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_ANACONDA:2
msgid "``True`` if executed in an Anaconda instance, else ``False``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_ANDROID:2
msgid ""
"``True`` on any Android userland — Termux, UserLAnd, proot-distro, Linux "
"Deploy chroot, etc."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_ANDROID:5
msgid ""
"Detection is layered: PEP 738 sets ``sys.platform == \"android\"`` and "
"``platform.system() == \"Android\"`` on Python 3.13+; for older Python "
"versions and proot/chroot setups where those checks miss, we fall back to "
"the presence of the ``ANDROID_ROOT`` environment variable (always exported "
"by the Android init) and finally to ``/system/build.prop``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_ANDROID:11
msgid ""
"Implies the Android app sandbox: ``/`` is typically unlistable, ``os."
"tcsetpgrp`` and ``os.link`` are restricted, the filesystem is non-FHS. Code "
"that needs Android-wide behaviour (e.g. ``skipif`` on tests that walk the FS "
"root) should key off this flag rather than ``ON_TERMUX`` so non-Termux "
"Android shells (UserLAnd, …) are covered."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_CYGWIN:2
msgid "``True`` if executed on a Cygwin Windows platform, else ``False``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_DARWIN:2
msgid "``True`` if executed on a Darwin platform, else ``False``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_DRAGONFLY:2
msgid "``True`` if on a DragonFly BSD operating system, else ``False``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_FREEBSD:2
msgid "``True`` if on a FreeBSD operating system, else ``False``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_LINUX:2
msgid "``True`` if executed on a Linux platform, else ``False``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_MSYS:2
msgid "``True`` if executed on a MSYS Windows platform, else ``False``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_NETBSD:2
msgid "``True`` if on a NetBSD operating system, else ``False``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_OPENBSD:2
msgid "``True`` if on a OpenBSD operating system, else ``False``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_POSIX:2
msgid "``True`` if executed on a POSIX-compliant platform, else ``False``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_TERMUX:2
msgid ""
"``True`` specifically inside the Termux app (and forks that keep its "
"``TERMUX_VERSION`` env var)."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_TERMUX:5
msgid ""
"Detected via ``TERMUX_VERSION`` which Termux exports in every shell it "
"spawns. Implies :data:`ON_ANDROID`, plus the Termux userland layout under "
"``$PREFIX = /data/data/com.termux/files/usr``. Use this flag for Termux-"
"specific path defaults (``$PREFIX/bin``, completion script locations, etc.); "
"use :data:`ON_ANDROID` for sandbox/bionic concerns that apply to any Android "
"userland."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of xonsh.platform.ON_WINDOWS:2
msgid "``True`` if executed on a native Windows platform, else ``False``."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of
#: xonsh.platform.PYTHON_VERSION_INFO:2
msgid "Version of Python interpreter as three-value tuple."
msgstr ""

#: ../../../../xonsh/platform.py:docstring of
#: xonsh.platform.minimum_required_ptk_version:2
msgid "Minimum version of prompt-toolkit supported by Xonsh"
msgstr ""
